# Local settings for TimeWise. Copy this file to .env and fill in the values.
# Every setting is optional for local development.

# Free Gemini API key from https://aistudio.google.com/apikey
# Without it, TimeWise shows rule-based tips instead of AI suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Storage backend: "sqlite" (local file, default) or "bigquery" (deployed app).
TIMEWISE_DATABASE=sqlite
TIMEWISE_SQLITE_PATH=data/timewise.db

# Required only when TIMEWISE_DATABASE=bigquery.
TIMEWISE_BIGQUERY_PROJECT=
TIMEWISE_BIGQUERY_DATASET=timewise

# Secret used to encrypt the sign-in cookie. Required with BigQuery; set a
# long random value in production (python -c "import secrets; print(secrets.token_urlsafe(32))").
TIMEWISE_COOKIE_SECRET=
